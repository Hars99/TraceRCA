DEMO_APP_PORT=3001
PROVIDER_SIMULATOR_PORT=4001

MAX_RETRIES=3
RETRY_DELAY_MS=750
TELEMETRY_MAX_EVENTS=5000
PRIMARY_PROVIDER=provider-a
FALLBACK_PROVIDER=provider-b

# URL used by demo-ai-app to reach the provider simulator
# For local (non-Docker) runs use http://localhost:4001
# Docker Compose overrides this to http://provider-simulator:4001
PROVIDER_SIMULATOR_URL=http://localhost:4001
